{
    "schemaVersion": "2.2.0",
    "resources": {
        "linux": {
            "user": {
                "groups": ["pipewire"]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "Train Audio Detection",
            "appName": "train_detect",
            "vendor": "mrdnlabs",
            "vendorId": "0000000000",
            "vendorUrl": "https://github.com/mrdnlabs",
            "runMode": "respawn",
            "version": "0.5.2",
            "compatibleOsVersions": [
                {
                    "min": "12.11.72",
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "settingPage": "index.html",
            "httpConfig": [
                {
                    "access": "operator",
                    "name": "status.cgi",
                    "type": "fastCgi"
                },
                {
                    "access": "admin",
                    "name": "analyze.cgi",
                    "type": "fastCgi"
                },
                {
                    "access": "operator",
                    "name": "label.cgi",
                    "type": "fastCgi"
                },
                {
                    "access": "operator",
                    "name": "timeline.cgi",
                    "type": "fastCgi"
                }
            ],
            "paramConfig": [
                { "name": "Enabled", "default": "yes", "type": "bool:no,yes" },
                { "name": "Sensitivity", "default": "50", "type": "int:min=1;max=100" },
                { "name": "TriggerSeconds", "default": "3", "type": "string" },
                { "name": "ReleaseSeconds", "default": "8", "type": "string" },
                { "name": "SmoothingSeconds", "default": "2", "type": "string" },
                { "name": "MinLevelDbfs", "default": "-65", "type": "int:min=-90;max=-10" },
                { "name": "CooldownSeconds", "default": "10", "type": "int:min=0;max=300" },
                { "name": "HornSensitivity", "default": "50", "type": "int:min=1;max=100" },
                { "name": "HornTriggers", "default": "yes", "type": "bool:no,yes" },
                { "name": "MaxEventSeconds", "default": "600", "type": "int:min=0;max=3600" },
                { "name": "SpeechSuppression", "default": "100", "type": "int:min=0;max=100" },
                { "name": "RequireRailSound", "default": "no", "type": "bool:no,yes" },
                { "name": "MinRiseDb", "default": "0", "type": "int:min=0;max=20" },
                { "name": "HornIncludesOtherHorns", "default": "no", "type": "bool:no,yes" },
                { "name": "ScoreSource", "default": "head", "type": "enum:head|Trained detector, yamnet|YAMNet rail classes, max|Higher of the two" }
            ]
        }
    }
}
